PORT=3000
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-random-string
DB_PATH=./data/infoscreen.db
UPLOAD_DIR=./uploads

# ─── Cloud-Relay (optional) ──────────────────────────────────────────────────────
# Lokaler Server syncronisiert Bildschirm-Daten mit einem Relay-Server in der Cloud.
# Remote-Screens verbinden sich direkt zum Relay statt zum lokalen Netzwerk.

# RELAY_URL=https://relay.example.org        # URL des Relay-Servers (relay-server.js)
# RELAY_SECRET=ein-langes-zufaelliges-secret  # Muss auf Relay identisch sein
